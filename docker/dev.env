# 手元で `pnpm dev` を動かすための設定。
# docker/docker-compose.yml と対になるローカル専用の固定値で、
# 本番の認証情報を書かないこと。
# テスト用の接続先は別（IT: vitest.config.it.ts / E2E: packages/e2e/setup/env.ts）。
PORT=3000
CID_DB_URL=postgres://user:pass@localhost:5432/db
EVENTS_TABLE_NAME=events
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "it-tests/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "packages/e2e"]
}
